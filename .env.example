# ==============================================================================
# CareVoice Environment Configuration Template
# ==============================================================================

# Application & Security
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev # Use 'dev' for zero-setup H2 in-memory DB or 'prod' for PostgreSQL
JWT_SECRET=CareVoiceSuperSecretSigningKeyForProductionAdherenceTracking2026!
JWT_EXPIRATION_MS=86400000

# Telephony Configuration
# Mode: 'simulator' (default for offline demo/dev without paid phone) or 'twilio' (live calls)
TELEPHONY_PROVIDER=simulator

# Twilio Credentials (Required ONLY if TELEPHONY_PROVIDER=twilio)
# Account: Create a free trial or production account at https://www.twilio.com
# Where stored: Set as environment variable or in this .env file
# Why needed: To dispatch real cellular telephone calls and receive DTMF keypad tones
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+15005550006
WEBHOOK_BASE_URL=https://your-public-ngrok-or-domain.com

# PostgreSQL Database (Required if SPRING_PROFILES_ACTIVE=prod)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carevoice
DB_USER=postgres
DB_PASSWORD=postgrespassword

# Email / SMTP Alerts (Optional - Falls back to Console Logger if omitted)
# Provider: Gmail App Password, SendGrid, Amazon SES, or Mailgun
# Why needed: To send email notifications to caregivers when doses are missed or stock runs low
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-caregiver-alerts@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
